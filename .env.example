# App
DEBUG=False

# Tidal
TIDAL_QUALITY=LOSSLESS

# Valkey / Redis — protocolo RESP2/RESP3, compatible con ambos
# Dev local sin Docker: instalar Valkey (https://valkey.io) o Redis 7
# Docker: el compose levanta valkey/valkey:8-alpine automáticamente
REDIS_URL=redis://localhost:6379

# PostgreSQL (Phase 3)
DATABASE_URL=postgresql://music4all:password@localhost:5432/music4all

# CORS — orígenes separados por coma
CORS_ORIGINS=http://localhost:3000

# Frontend
BACKEND_URL=http://backend:8000
