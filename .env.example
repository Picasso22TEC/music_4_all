# Copiar a `.env` (ignorado por git). Docker Compose lo lee solo.

# App
DEBUG=False

# Entorno: "development" (por defecto) o "production". En producción el backend valida
# la config sensible al arrancar y **se niega a arrancar** si sigue con defaults de
# desarrollo. Para production hay que setear, como mínimo:
#   - SESSION_ENCRYPTION_KEY (abajo)
#   - COOKIE_SECURE=True
#   - CORS_ORIGINS con tu dominio real (sin localhost)
ENVIRONMENT=development

# Cookies solo por HTTPS. False en dev (HTTP); **True obligatorio en producción**.
COOKIE_SECURE=False

# Cifra los tokens de Tidal en reposo. Genera un valor con:
#   docker compose exec backend sh -c '/app/.venv/bin/python -c "import secrets; print(secrets.token_hex(32))"'
#
# **Obligatoria en producción**, y muy recomendable en desarrollo: si va vacía, el
# backend usa una clave efímera por proceso. Como el contenedor corre uvicorn con
# --reload, cualquier edición de un archivo del backend reinicia el proceso, genera
# otra clave y deja los tokens ya guardados indescifrables. El síntoma despista: la
# sesión de app sigue viva, pero Tidal responde 401 y la web dice "sesión expirada".
# Ver docs/troubleshooting.md §1.c.
SESSION_ENCRYPTION_KEY=

# Tidal
TIDAL_QUALITY=LOSSLESS

# Valkey / Redis — protocolo RESP2/RESP3, compatible con ambos
# Dev local sin Docker: instalar Valkey (https://valkey.io) o Redis 7
# Docker: el compose levanta valkey/valkey:8-alpine automáticamente
REDIS_URL=redis://localhost:6379

# PostgreSQL (Phase 3)
DATABASE_URL=postgresql://music4all:password@localhost:5432/music4all

# CORS — orígenes separados por coma
CORS_ORIGINS=http://localhost:3000

# Frontend
BACKEND_URL=http://backend:8000

# Grafana — credenciales del admin. Cambiar en producción (el default es 'admin').
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
